# Google OAuth credentials für Momente-Galerie (Drive) und RSVP-Speicherung (Sheets).
# Lokal: diese Datei zu ".env" kopieren und Werte eintragen.
# Auf Railway: unter "Variables" direkt eintragen, nicht committen.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ID=
PORT=3000
